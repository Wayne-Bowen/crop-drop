# Copy to .env and fill in. Never commit .env.
PORT=3000
NODE_ENV=development
# Local Postgres. On a host, paste the connection string it gives you.
DATABASE_URL=postgres://cropdrop:cropdrop@localhost:5432/cropdrop
# Set to true when the database host requires SSL (most hosted Postgres does).
DATABASE_SSL=false
# Long random string. Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me
# The first admin account. Leave ADMIN_PASSWORD empty to have one generated and printed once on first run.
ADMIN_EMAIL=test@email.com
ADMIN_PASSWORD=
